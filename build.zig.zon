// Project manifest for `zig build`.
//
// To add dvui (the GUI library), once-only after first `nix develop`:
//
//     zig fetch --save git+https://github.com/david-vanderson/dvui#main
//
// That populates `.dependencies.dvui` with the right URL + content hash and
// makes `@import("dvui")` resolvable from build.zig.

.{
    .name = .f69,
    .version = "0.15.9",

    // Project fingerprint. Zig validates the low 32 bits encode the
    // package name; if the build complains, paste the suggested value here.
    .fingerprint = 0x650277fd37a9eb2d,

    .minimum_zig_version = "0.17.0",

    .dependencies = .{
        .dvui = .{
            .url = "git+https://github.com/david-vanderson/dvui?ref=main#f85184497c5d231e398344d288d6626e9d6d792c",
            .hash = "dvui-0.6.0-dev-AQFJmXqTBAGIFho3xAKct320CiNm-lvshf7_c1Q_Eur9",
        },
        .zqlite = .{
            .url = "git+https://github.com/karlseguin/zqlite.zig?ref=master#865223b734a5113f731ab1eb1d7d81c8ac252913",
            .hash = "zqlite-0.0.1-RWLaY4Y8nADz2l5aBE-JVyDyM3sZzHjq0agNykuVZKqQ",
        },
        .websocket = .{ .path = "third_party/websocket" },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools",
        "third_party/websocket",
    },
}
